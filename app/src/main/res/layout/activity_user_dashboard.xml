<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PANEL DE CONTROL IOT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvConexion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desconectado"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnConectar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CONECTAR AL NODO SENSOR"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvHumedadMonitor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Humedad recibida: --%"
        android:textSize="24sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvBombaRemota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bomba: --"
        android:textSize="18sp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnRegarManual"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ACTIVAR RIEGO AHORA"
        android:backgroundTint="#009688"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnHistorial"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="VER HISTORIAL"
        android:layout_marginTop="12dp" />
</LinearLayout>
