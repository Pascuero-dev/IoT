<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RIEGO AUTOMÁTICO IoT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sesión iniciada"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa la clave compartida (la misma en ambos teléfonos)"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etClave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Clave (mínimo 8 caracteres)"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnSensor"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="USAR COMO NODO SENSOR"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnUsuario"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="USAR COMO PANEL DE CONTROL"
        android:backgroundTint="#009688"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnSalir"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CERRAR SESIÓN"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desarrollado por Benjamín Maldonado"
        android:textSize="12sp"
        android:layout_marginTop="32dp" />
</LinearLayout>
