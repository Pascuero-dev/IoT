<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!-- Android 11 o inferior (permisos "normales", sin pedirlos en ejecución) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Android 12+ : solo se necesita CONNECT (no escaneamos, usamos dispositivos emparejados) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Riego IoT"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartIrrigation">

        <activity
            android:name="com.tuproyecto.smartirrigation.ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.tuproyecto.smartirrigation.ui.MainActivity" android:exported="false" />
        <activity android:name="com.tuproyecto.smartirrigation.ui.HistoryActivity" android:exported="false" />
        <activity
            android:name="com.tuproyecto.smartirrigation.ui.SensorNodeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity
            android:name="com.tuproyecto.smartirrigation.ui.UserDashboardActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    </application>
</manifest>
